# Copy to .env and fill in real values for local dev. Never commit .env.

# Postgres connection string. Matches docker-compose.yml dev credentials.
DATABASE_URL=postgresql+psycopg://sitesignal:sitesignal@localhost:5433/sitesignal

# JWT signing secret. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-generated-secret

# JWT algorithm + lifetime (minutes)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins (no wildcard with credentials)
CORS_ORIGINS=http://localhost:3000

# Crawler limits
CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=5
CRAWL_TIMEOUT_SECONDS=10
CRAWL_MAX_RESPONSE_BYTES=5000000
